---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'responsible-ai');
const { Content } = await render(entry);
---

<BaseLayout
  title="Responsible AI in Education — Jiaqi Yu, PhD"
  description="Four principles guiding Jiaqi Yu's work with AI in instructional design, faculty development, and the scholarship of teaching and learning."
>
  <article class="case-study max-w-2xl mx-auto px-6 py-16">
    <Content />
  </article>
</BaseLayout>