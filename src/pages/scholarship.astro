---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const works = (await getCollection('works')).map(w => w.data);
const highlights = (await getCollection('highlights')).map(h => h.data);
const profiles = (await getCollection('scholarProfiles')).map(p => p.data);

const counts = {
  all: works.length,
  pub: works.filter(w => w.kind === 'pub').length,
  pres: works.filter(w => w.kind === 'pres').length,
};
const years = [...new Set(works.map(w => w.year))].sort((a, b) => b - a);
const groups = years.map(year => ({ year, items: works.filter(w => w.year === year) }));

const typeChips = [
  { key: 'all', label: 'All', n: counts.all },
  { key: 'pub', label: 'Publications', n: counts.pub },
  { key: 'pres', label: 'Presentations', n: counts.pres },
];
---

<BaseLayout
  title="Scholarship — Jiaqi Yu, PhD"
  description="Selected publications and conference presentations by Jiaqi Yu, PhD — instructional design, SoTL, faculty development, and AI in education."
>
  <div class="site-container">
    <section class="head">
      <div class="flex flex-col gap-[18px]">
        <h1 class="h1-page">Scholarship</h1>
        <p class="lead">Publications and presentations across instructional design, Communities of Practice, faculty development, and the scholarship of teaching and learning.</p>
      </div>
      <div class="flex flex-col gap-2.5">
        <span class="text-sm subtle">For the most current view across venues:</span>
        <ul class="flex flex-wrap gap-2 list-none m-0 p-0">
          {profiles.map(p => (
            <li><a href={p.url} class="profile-pill">{p.label} ↗</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="highlights">
      <h2 class="eyebrow tracking-[0.08em] mb-[18px]">Selected highlights</h2>
      <div class="fluid-grid">
        {highlights.map(h => (
          <div class="highlight panel-navy">
            <span class="pill-gold px-3">{h.label}</span>
            <h3 class="highlight-title">
              {h.url ? <a href={h.url}>{h.title}</a> : h.title}
            </h3>
            <p class="m-0 text-[15.5px] text-pretty">{h.note}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="list rule-top" id="works" data-works>
      <div class="filters">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by type">
          {typeChips.map((c, i) => (
            <button type="button" class="chip chip-type" data-filter="type" data-value={c.key} aria-pressed={i === 0 ? 'true' : 'false'}>
              {c.label} <span class="chip-n">{c.n}</span>
            </button>
          ))}
        </div>
        <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter by year">
          <button type="button" class="chip chip-year" data-filter="year" data-value="all" aria-pressed="true">All years</button>
          {years.map(y => (
            <button type="button" class="chip chip-year" data-filter="year" data-value={String(y)} aria-pressed="false">{y}</button>
          ))}
        </div>
        <span class="text-sm subtle" aria-live="polite" data-count>Showing {works.length} works</span>
      </div>

      <div class="empty" data-empty hidden>
        <span>No works match that combination.</span>
        <button type="button" class="btn btn-primary clear" data-clear>Clear filters</button>
      </div>

      <div class="flex flex-col gap-2">
        {groups.map(g => (
          <div class="year-group" data-group data-year={g.year}>
            <h3 class="year">{g.year}</h3>
            <ul class="items">
              {g.items.map(w => (
                <li class="item" data-item data-type={w.kind} data-year={w.year}>
                  <span class:list={['badge', w.kind === 'pub' ? 'badge-pub' : 'badge-pres']}>{w.type}</span>
                  {w.url
                    ? <a href={w.url} class="work-title">{w.title} ↗</a>
                    : <span class="work-title">{w.title}</span>}
                  {w.venue && <span class="text-[15.5px] muted">{w.venue}</span>}
                  {w.meta && <span class="text-sm subtle">{w.meta}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-works]');
  if (root) {
    const state = { type: 'all', year: 'all' };
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-item]')];
    const groups = [...root.querySelectorAll<HTMLElement>('[data-group]')];
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;

    const valid = (key: 'type' | 'year', v: string | null) =>
      v !== null && chips.some(c => c.dataset.filter === key && c.dataset.value === v);

    const readUrl = () => {
      const q = new URLSearchParams(location.search);
      state.type = valid('type', q.get('type')) ? q.get('type')! : 'all';
      state.year = valid('year', q.get('year')) ? q.get('year')! : 'all';
    };

    const writeUrl = () => {
      const q = new URLSearchParams(location.search);
      state.type === 'all' ? q.delete('type') : q.set('type', state.type);
      state.year === 'all' ? q.delete('year') : q.set('year', state.year);
      const qs = q.toString();
      history.replaceState(null, '', `${location.pathname}${qs ? `?${qs}` : ''}${location.hash}`);
    };

    const render = () => {
      let shown = 0;
      for (const el of items) {
        const match =
          (state.type === 'all' || el.dataset.type === state.type) &&
          (state.year === 'all' || el.dataset.year === state.year);
        el.hidden = !match;
        if (match) shown++;
      }
      for (const g of groups) {
        g.hidden = !g.querySelector('[data-item]:not([hidden])');
      }
      for (const c of chips) {
        const active = state[c.dataset.filter as 'type' | 'year'] === c.dataset.value;
        c.setAttribute('aria-pressed', String(active));
      }
      count.textContent = `Showing ${shown} ${shown === 1 ? 'work' : 'works'}`;
      empty.hidden = shown !== 0;
    };

    for (const c of chips) {
      c.addEventListener('click', () => {
        state[c.dataset.filter as 'type' | 'year'] = c.dataset.value!;
        render();
        writeUrl();
      });
    }
    root.querySelector('[data-clear]')?.addEventListener('click', () => {
      state.type = 'all';
      state.year = 'all';
      render();
      writeUrl();
    });

    readUrl();
    render();
  }
</script>

<style>
  .head {
    padding: clamp(32px, 6vw, 64px) 0 32px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: 20px 64px;
    align-items: end;
  }
  .profile-pill {
    display: inline-block;
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 8px 16px;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-navy);
    transition: background-color 0.2s;
  }
  .profile-pill:hover { background: var(--color-gold-soft); color: var(--color-navy); }

  .highlights { padding: 8px 0 clamp(40px, 6vw, 64px); }
  .highlight {
    border-radius: var(--radius-card);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .highlight-title {
    margin: 0;
    font-weight: 500;
    font-size: 23px;
    line-height: 1.22;
    color: var(--color-surface);
    text-wrap: pretty;
  }
  .highlight-title a { color: var(--color-surface); text-decoration-color: var(--color-gold-light); }

  .list { padding: clamp(32px, 5vw, 56px) 0 clamp(56px, 8vw, 96px); }
  .filters { display: flex; flex-direction: column; gap: 14px; margin-bottom: 28px; }
  .chip {
    cursor: pointer;
    font: inherit;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-navy);
    transition: background-color 0.15s, border-color 0.15s;
  }
  .chip:hover { border-color: var(--color-line-strong); }
  .chip[aria-pressed="true"] {
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: var(--color-surface);
  }
  .chip-type {
    font-size: 15px;
    font-weight: 600;
    padding: 9px 18px;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .chip-n { opacity: 0.7; font-weight: 500; }
  .chip-year { font-size: 14px; font-weight: 500; padding: 5px 13px; }

  .empty {
    background: var(--color-surface);
    border: 1px dashed var(--color-line-strong);
    border-radius: 20px;
    padding: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
  }
  .empty[hidden] { display: none; }
  .clear { padding: 10px 18px; }

  /* Year column + items; items wrap under the year on narrow screens */
  .year-group {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 32px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
  }
  .year-group[hidden] { display: none; }
  .year {
    font-family: var(--font-display);
    font-size: 34px;
    font-style: italic;
    line-height: 1.1;
    color: var(--color-gold);
    flex: 1 0 120px;
    max-width: 200px;
  }
  .items {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column;
    flex: 7 1 min(100%, 560px);
    min-width: 0;
  }
  .item { display: flex; flex-direction: column; gap: 6px; padding: 4px 0 22px; }
  .item[hidden] { display: none; }
  .badge {
    align-self: flex-start;
    border-radius: 999px;
    padding: 2px 11px;
    font-size: 12.5px;
    font-weight: 600;
  }
  .badge-pub { background: var(--color-gold-soft); color: var(--color-gold-ink-deep); }
  .badge-pres { background: var(--color-pres-bg); color: var(--color-navy); }
  .work-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-navy);
    text-wrap: pretty;
  }
</style>
