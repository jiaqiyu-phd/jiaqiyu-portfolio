  { label: "ResearchGate", url: "https://www.researchgate.net/profile/Jiaqi-Yu-33" },
];

// Group presentations by year for display
const presByYear = presentations.reduce((acc, p) => {
  const y = p.year;
  if (!acc[y]) acc[y] = [];
  acc[y].push(p);
  return acc;
}, {} as Record<string, typeof presentations>);
const presYears = Object.keys(presByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout
  title="Scholarship — Jiaqi Yu, PhD"
  description="Selected publications and conference presentations by Jiaqi Yu, PhD — instructional design, SoTL, faculty development, and AI in education."
>
  <section class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-semibold mb-4">Scholarship</h1>
    <p class="text-lg text-gray-soft leading-relaxed mb-8 max-w-3xl">
      Publications and conference presentations across instructional design, Communities of Practice, faculty development, and the scholarship of teaching and learning. For the most current view across all venues, see also my public profiles:
    </p>

    <div class="profile-links mb-16">
      {profiles.map(p => (
        <a href={p.url} class="profile-link">{p.label}</a>
      ))}
    </div>

    <h2 class="scholarship-section-heading">Publications ({publications.length})</h2>
    <ul class="scholarship-list mb-16">
      {publications.map(pub => (
        <li>
          <div class="item-year">{pub.year}</div>
          <div class="item-body">
            <div class="item-type">{pub.type}</div>
            <div class="item-authors">{pub.authors}</div>
            <div class="item-title">
              {pub.url ? <a href={pub.url} target="_blank" rel="noopener">{pub.title}</a> : pub.title}
            </div>
            <div class="item-venue">{pub.venue}</div>
          </div>
        </li>
      ))}
    </ul>

    <h2 class="scholarship-section-heading">Presentations ({presentations.length})</h2>
    {presYears.map(year => (
      <div class="pres-year-group mb-8">
        <h3 class="pres-year-header">{year}</h3>
        <ul class="scholarship-list">
          {presByYear[year].map(pres => (
            <li class="pres-item">
              <div class="item-body">
                <div class="item-title">
                  {pres.link ? <a href={pres.link} target="_blank" rel="noopener">{pres.title}</a> : pres.title}
                </div>
                <div class="item-venue">{pres.venue}{pres.location ? ` · ${pres.location}` : ''}</div>
                <div class="item-meta">
                  {pres.role}{pres.coPresenters ? ` · with ${pres.coPresenters}` : ''}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .profile-links { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .profile-link {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-navy);
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--color-navy);
    border-radius: 3px;
    transition: background 0.15s, color 0.15s;
  }
  .profile-link:hover { background: var(--color-navy); color: white; }
  .scholarship-section-heading {
    font-size: 1.5rem;
    color: var(--color-navy);
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-gold);
  }
  .scholarship-list { list-style: none; padding: 0; margin: 0; }
  .scholarship-list li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid #F3F4F6;
    align-items: baseline;
  }
  .scholarship-list li.pres-item {
    grid-template-columns: 1fr;
  }
  .scholarship-list li:last-child { border-bottom: none; }
  .item-year {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-gold);
    font-size: 1.1rem;
  }
  .item-type {
    font-family: var(--font-body);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-gold);
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .item-authors {
    font-size: 0.9rem;
    color: var(--color-gray-soft);
    margin-bottom: 0.25rem;
  }
  .item-title {
    font-size: 1rem;
    color: var(--color-navy);
    font-weight: 500;
    line-height: 1.4;
    margin-bottom: 0.25rem;
  }
  .item-title a {
    color: var(--color-navy);
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
  }
  .item-venue {
    font-size: 0.9rem;
    color: var(--color-ink);
    font-style: italic;
    line-height: 1.4;
    margin-bottom: 0.25rem;
  }
  .item-meta {
    font-size: 0.85rem;
    color: var(--color-gray-soft);
    line-height: 1.4;
  }
  .pres-year-header {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-gold);
    font-weight: 700;
    margin: 0 0 0.75rem 0;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid #F3F4F6;
  }
</style>
