---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const slugOf = (p: (typeof all)[number]) => p.data.slug ?? p.id;
const href = (p: (typeof all)[number]) => p.data.url ?? `/projects/${slugOf(p)}/`;

const flagship = all.find(p => slugOf(p) === 'sotl-collective') ?? all[0];
const others = all.filter(p => p !== flagship);

// Years strings vary ("2025–Present" vs "Fall 2022 (redesign); 2023–2024 …"),
// so the rail shows the first four-digit year only.
const startYear = (years?: string) => years?.match(/\d{4}/)?.[0] ?? '';
---

<BaseLayout
  title="Projects — Jiaqi Yu, PhD"
  description="Six projects spanning Communities of Practice, faculty partnership, cross-institutional collaboration, and community-led work in health sciences education."
>
  <div class="site-container">
    <section class="page-intro">
      <h1 class="h1-page">Projects</h1>
      <p class="lead">Six projects showing how the same design principles travel — from faculty development at UNT Health, to a national peer mentoring network, to a bilingual book club in Dallas–Fort Worth.</p>
    </section>

    {flagship && (
      <a href={href(flagship)} class="flagship">
        <div class="flex flex-col gap-3">
          <span class="pill-gold">Flagship{flagship.data.tag && ` · ${flagship.data.tag}`}</span>
          <h2 class="flagship-title">{flagship.data.card_title ?? flagship.data.title}</h2>
        </div>
        <p class="flagship-summary">{flagship.data.summary} <span class="flagship-cta">Read the case study →</span></p>
      </a>
    )}

    <div class="others">
      {others.map(p => (
        <a href={href(p)} class={`project-band${p.data.status === 'mini' ? ' is-mini' : ''}`}>
          <div class="band-circle" aria-hidden="true"></div>
          <div class="band-rail">
            <span class="band-year">{startYear(p.data.years)}</span>
            {p.data.status === 'mini' && <span class="band-badge">Mini case</span>}
          </div>
          <div class="band-body">
            <span class="eyebrow">{p.data.tag ?? p.data.themes?.[0]}</span>
            <h3 class="h3-card band-title">{p.data.card_title ?? p.data.title}</h3>
            <p class="band-summary muted text-pretty">{p.data.summary}</p>
            <span class="card-cta">Read the case study →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .flagship {
    text-decoration: none;
    color: inherit;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 24px 48px;
    align-items: end;
    background: var(--color-navy);
    border-radius: var(--radius-hero);
    padding: clamp(28px, 4vw, 48px);
    margin-bottom: 20px;
    transition: background-color 0.2s;
  }
  .flagship:hover { background: var(--color-navy-light); color: inherit; }
  .flagship-title {
    margin: 0;
    font-weight: 500;
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.1;
    color: var(--color-surface);
  }
  .flagship-summary {
    margin: 0;
    color: var(--color-on-navy);
    font-size: 18px;
    text-wrap: pretty;
  }
  .flagship-cta { color: var(--color-gold-light); font-weight: 600; }
  /* Stacked bands, matching the Recognition page: no orphaned cards at any
     count, and the summary gets a readable measure. */
  .others {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-bottom: clamp(56px, 8vw, 96px);
  }
  .project-band {
    text-decoration: none;
    color: inherit;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-gold-ink);
    border-radius: var(--radius-panel);
    padding: 30px 34px;
    display: grid;
    grid-template-columns: 118px minmax(0, 1fr);
    gap: 30px;
    align-items: start;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }
  /* Mini case studies keep a lighter spine so the hierarchy stays visible. */
  .project-band.is-mini { border-left-color: var(--color-line); }
  .project-band:hover {
    border-color: var(--color-gold-ink);
    transform: translateY(-2px);
  }
  .band-circle {
    position: absolute;
    top: -52px;
    right: -52px;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: var(--color-gold-soft);
    pointer-events: none;
  }
  .band-rail {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .band-year {
    font-family: var(--font-display);
    font-size: 44px;
    font-style: italic;
    line-height: 1;
    color: var(--color-gold-ink);
  }
  .band-badge {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gold-ink-deep);
    background: var(--color-gold-soft);
    border-radius: 999px;
    padding: 4px 10px;
    white-space: nowrap;
  }
  .band-body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .band-title { font-size: 25px; margin: 0; }
  .band-summary { margin: 0; font-size: 16px; max-width: 68ch; }

  @media (max-width: 640px) {
    .project-band {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 26px 24px;
    }
    .band-rail {
      flex-direction: row;
      align-items: baseline;
      gap: 14px;
    }
    .band-year { font-size: 36px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-band { transition: none; }
    .project-band:hover { transform: none; }
  }
</style>
