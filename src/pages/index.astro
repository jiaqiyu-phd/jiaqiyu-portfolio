---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { signature, cvUrl, rootsUrl } from '../data/site';
import portrait from '../assets/images/jiaqi-square.jpg';

const featured = (await getCollection('projects', p => p.data.featured))
  .sort((a, b) => a.data.order - b.data.order);
const projectCount = (await getCollection('projects')).length;
const countWords = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const seeAll = `See all ${countWords[projectCount] ?? projectCount} →`;
const href = (p: (typeof featured)[number]) => p.data.url ?? `/projects/${p.data.slug ?? p.id}/`;
---

<BaseLayout title="Jiaqi Yu, PhD">
  <div class="site-container">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-copy">
        <span class="hero-eyebrow">Instructional Design · Project Management · Faculty Development</span>
        <h1 class="hero-title">I build Communities of Practice that make scholarship <em>sustainable</em> for the people doing it.</h1>
        <p class="lead hero-lead">Assistant Director of Instructional Innovation and Project Management at UNT Health Fort Worth — empowering instructional designers and advancing the scholarship of teaching and learning.</p>
        <div class="hero-ctas">
          <a href="/projects/" class="btn btn-primary">View projects</a>
          <a href={cvUrl} class="btn btn-secondary">Download CV</a>
        </div>
      </div>
      <div class="hero-photo">
        <div class="arch-shape" aria-hidden="true"></div>
        <Picture
          src={portrait}
          alt="Portrait of Jiaqi Yu, PhD"
          formats={['avif', 'webp']}
          widths={[440, 880]}
          width={880}
          sizes="(min-width: 900px) 440px, 90vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </section>

    <!-- Signature contributions -->
    <section class="section rule-top">
      <h2 class="h2-section mb-8">Signature contributions</h2>
      <div class="fluid-grid">
        {signature.map(s => (
          <a href={s.url} class="card">
            <span class="numeral">{s.n}</span>
            <h3 class="h3-card">{s.title}</h3>
            <p class="m-0 font-semibold text-ink">{s.lead}</p>
            <p class="m-0 muted text-base text-pretty">{s.body}</p>
            <span class="card-cta">Explore →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Featured projects -->
    <section class="section rule-top">
      <div class="featured-head">
        <h2 class="h2-section">Featured projects</h2>
        <a href="/projects/" class="font-semibold">{seeAll}</a>
      </div>
      <div class="flex flex-col">
        {featured.map(p => (
          <a href={href(p)} class="project-row">
            <div class="flex flex-col gap-2">
              <span class="eyebrow">{p.data.tag}</span>
              <h3 class="h3-card row-title">{p.data.card_title ?? p.data.title}</h3>
            </div>
            <p class="m-0 muted text-pretty">{p.data.summary} <span class="read">Read →</span></p>
          </a>
        ))}
      </div>
    </section>

    <!-- Values panel -->
    <section class="values panel-navy">
      <h2 class="values-title">Care for the people doing the work <em>is</em> part of the work.</h2>
      <div class="flex flex-col gap-5">
        <p class="m-0 text-lg text-pretty">Scholar-practitioner, first-generation college student, immigrant scholar, and working parent — perspectives that shape why I build Communities of Practice rather than one-off workshops.</p>
        <a href={rootsUrl} class="btn btn-gold self-start">What guides my work →</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding: clamp(32px, 6vw, 72px) 0 clamp(48px, 7vw, 96px);
  }
  .hero-copy { display: flex; flex-direction: column; gap: 24px; }
  .hero-eyebrow {
    align-self: flex-start;
    background: var(--color-gold-soft);
    color: var(--color-gold-ink-deep);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .hero-title {
    margin: 0;
    font-weight: 500;
    font-size: clamp(38px, 5vw, 60px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .hero-title em { font-style: italic; color: var(--color-gold-ink); }
  .hero-lead { max-width: 34em; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }

  .hero-photo {
    position: relative;
    max-width: 440px;
    width: 100%;
    justify-self: center;
  }
  .arch-shape {
    position: absolute;
    right: -18px;
    bottom: -18px;
    width: 72%;
    height: 72%;
    border-radius: 999px 999px 28px 28px;
    background: var(--color-gold-soft);
  }
  .hero-photo :global(img) {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 999px 999px 28px 28px;
  }

  .featured-head {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 24px;
  }
  .project-row {
    text-decoration: none;
    color: inherit;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 12px 40px;
    padding: 26px 20px;
    margin: 0 -20px;
    border-radius: 20px;
    border-bottom: 1px solid var(--color-line);
    transition: background-color 0.2s;
  }
  .project-row:hover { background: var(--color-surface); color: inherit; }
  .row-title { font-size: 26px; text-wrap: wrap; }
  .read { color: var(--color-navy); font-weight: 600; white-space: nowrap; }

  .values {
    margin: clamp(24px, 4vw, 48px) 0 clamp(56px, 8vw, 96px);
    color: var(--color-on-navy-strong);
    border-radius: var(--radius-hero);
    padding: clamp(32px, 5vw, 64px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 32px;
    align-items: center;
  }
  .values-title {
    margin: 0;
    font-weight: 500;
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.12;
    color: var(--color-surface);
    text-wrap: balance;
  }
  .values-title em { color: var(--color-gold-light); }
</style>
