---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Jiaqi Yu, PhD">
  <section class="max-w-4xl mx-auto px-6 py-24 text-center">
    <p class="text-sm uppercase tracking-widest text-gold mb-4">
      Visual identity preview
    </p>
    <h1 class="text-4xl md:text-5xl font-semibold mb-6">
      Site frame is live.
    </h1>
    <p class="text-lg text-gray-soft leading-relaxed max-w-2xl mx-auto">
      Navy and gold tokens applied. Crimson Pro headings, Inter body type.
      Real content arrives in Session 4.
    </p>
  </section>
</BaseLayout>