---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { chapters, education, service, cvUrl, rootsUrl } from '../../data/site';
import portrait from '../../assets/images/jiaqi-portrait.jpg';
---

<BaseLayout
  title="About — Jiaqi Yu, PhD"
  description="About Jiaqi Yu, PhD — Instructional Innovation Leader at UNT Health at Fort Worth. Building sustainable Communities of Practice for health sciences education."
>
  <div class="site-container">
    <!-- Intro -->
    <section class="intro">
      <div class="portrait">
        <Picture
          src={portrait}
          alt="Portrait of Jiaqi Yu, PhD"
          formats={['avif', 'webp']}
          widths={[400, 800]}
          width={800}
          sizes="(min-width: 800px) 400px, 90vw"
          loading="eager"
        />
      </div>
      <div class="flex flex-col gap-5">
        <span class="tagline">Building communities · Designing possibilities · Empowering educators</span>
        <h1 class="h1-page">About Jiaqi</h1>
        <p class="lead">I build Communities of Practice, faculty development programs, and scholarly infrastructure in health sciences education. The common thread: making scholarship sustainable for clinical educators, instructional designers, and emerging scholars in a field that rarely stops changing.</p>
      </div>
    </section>

    <!-- Now / Then / Next -->
    <section class="fluid-grid chapters">
      {chapters.map(c => (
        <div class="card chapter">
          <span class="pill-soft">{c.k}</span>
          <p class="m-0 text-pretty">{c.body}</p>
        </div>
      ))}
    </section>

    <!-- Education + service -->
    <section class="section rule-top fluid-grid two-col">
      <div>
        <h2 class="h2-sub mb-5">Education</h2>
        <ul class="rows">
          {education.map(e => (
            <li class="row flex-col">
              <strong class="font-semibold text-navy">{e.a}</strong>
              <span class="subtle text-[15px]">{e.b}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="h2-sub mb-5">Selected service &amp; credentials</h2>
        <ul class="rows">
          {service.map(s => (
            <li class="row items-baseline gap-3.5">
              <span class="dot" aria-hidden="true"></span>
              <span>{s}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA cards -->
    <section class="fluid-grid ctas">
      <a href={rootsUrl} class="cta-card cta-navy">
        <span class="cta-eyebrow">Beyond the CV</span>
        <span class="cta-title">Roots &amp; leadership philosophy →</span>
        <span>First-generation scholar, immigrant, working parent — and what those experiences produce in practice.</span>
      </a>
      <a href={cvUrl} class="cta-card cta-gold">
        <span class="cta-eyebrow">Full record</span>
        <span class="cta-title">Download CV (PDF) →</span>
        <span>12 pages — education, experience, publications, presentations, awards, service, grants.</span>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
    padding: clamp(32px, 6vw, 64px) 0;
  }
  .portrait { width: 100%; max-width: 400px; justify-self: center; }
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius-panel);
  }
  .tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 20px;
    color: var(--color-gold-ink);
  }
  .chapters { padding: 24px 0 clamp(40px, 6vw, 72px); }
  .chapter { gap: 12px; }

  .two-col { --min: 340px; --gap: clamp(32px, 5vw, 64px); }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .row {
    display: flex;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-line);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-gold);
    flex: none;
    transform: translateY(-2px);
  }

  .ctas { --min: 320px; padding-bottom: clamp(56px, 8vw, 96px); }
  .cta-card {
    text-decoration: none;
    border-radius: var(--radius-panel);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: background-color 0.2s;
  }
  .cta-eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cta-title { font-family: var(--font-display); font-size: 28px; line-height: 1.2; }
  .cta-navy, .cta-navy:hover { color: var(--color-on-navy-strong); }
  .cta-navy { background: var(--color-navy); }
  .cta-navy:hover { background: var(--color-navy-light); }
  .cta-navy .cta-eyebrow { color: var(--color-gold-light); }
  .cta-navy .cta-title { color: var(--color-surface); }
  .cta-gold, .cta-gold:hover { color: var(--color-ink); }
  .cta-gold { background: var(--color-gold-soft); }
  .cta-gold:hover { background: var(--color-gold-soft-hover); }
  .cta-gold .cta-eyebrow { color: var(--color-gold-ink-deep); }
  .cta-gold .cta-title { color: var(--color-navy); }
</style>
