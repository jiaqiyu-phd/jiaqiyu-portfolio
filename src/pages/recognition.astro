---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const awards = (await getCollection('awards')).map(a => a.data);
const groups = (await getCollection('recognitionGroups')).map(g => g.data);
---

<BaseLayout
  title="Recognition — Jiaqi Yu, PhD"
  description="Awards, grants, fellowships, and microcredentials recognizing Jiaqi Yu's contributions to instructional innovation and health sciences education."
>
  <div class="site-container">
    <section class="page-intro">
      <h1 class="h1-page">Recognition</h1>
      <p class="lead">Grants, awards, fellowships, and microcredentials. Collaborative recognitions name the team; individual ones include the citation.</p>
    </section>

    <section class="fluid-grid awards">
      {awards.map(a => (
        <article class="award">
          <div class="award-circle" aria-hidden="true"></div>
          <div class="award-top">
            <span class="award-year">{a.year}</span>
            {a.team && <span class="award-team">{a.team}</span>}
          </div>
          <h2 class="h3-card relative text-[25px]">{a.title}</h2>
          <span class="font-semibold text-[15px]">{a.org}</span>
          {a.note && <p class="m-0 muted text-base text-pretty">{a.note}</p>}
        </article>
      ))}
    </section>

    <section class="groups rule-top">
      {groups.map(g => (
        <div>
          <h2 class="h2-sub text-[28px] mb-4">{g.name}</h2>
          <ul class="list-none m-0 p-0 flex flex-col">
            {g.items.map(i => (
              <li class="rec-row">
                <span class="rec-year">{i.year}</span>
                <div class="flex flex-col gap-0.5">
                  <span class="font-semibold text-ink text-pretty">{i.title}</span>
                  {i.org && <span class="text-[15px] subtle">{i.org}</span>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .awards { padding-bottom: clamp(48px, 7vw, 80px); }
  .award {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
    overflow: hidden;
  }
  .award-circle {
    position: absolute;
    top: -40px;
    right: -40px;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    background: var(--color-gold-soft);
  }
  .award-top {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .award-year {
    font-family: var(--font-display);
    font-size: 40px;
    font-style: italic;
    line-height: 1;
    color: var(--color-gold-ink);
  }
  .award-team {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gold-ink-deep);
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(32px, 5vw, 56px) clamp(32px, 5vw, 64px);
    padding: clamp(40px, 6vw, 64px) 0 clamp(56px, 8vw, 96px);
  }
  .rec-row {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--color-line);
  }
  .rec-year {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-gold-ink);
    padding-top: 2px;
  }
</style>
