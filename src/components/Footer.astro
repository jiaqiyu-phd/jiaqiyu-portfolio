---
import { connect } from "../data/site";

// Derived from build time, so it can never go stale. Every Netlify deploy —
// including CMS edits — refreshes this automatically.
const lastUpdated = new Date().toLocaleDateString("en-US", {
  month: "long",
  year: "numeric",
});
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-container footer-main">
    <div class="footer-cta">
      <span class="footer-title">Let's talk.</span>
      <span class="muted">Open to collaboration, speaking, and mentoring conversations.</span>
      <a href="/contact/" class="footer-contact">Get in touch →</a>
    </div>
    <ul class="footer-links" aria-label="Profiles">
      {connect.map(p => (
        <li><a href={p.url} class="pill-link">{p.label}</a></li>
      ))}
    </ul>
  </div>
  <div class="site-container footer-meta">
    © {currentYear} Jiaqi Yu, PhD · Last updated {lastUpdated}
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-sand);
    border-top: 1px solid var(--color-line);
  }
  .footer-main {
    padding-top: 48px;
    padding-bottom: 48px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    justify-content: space-between;
    align-items: flex-start;
  }
  .footer-cta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 360px;
  }
  .footer-title {
    font-family: var(--font-display);
    font-size: 26px;
    color: var(--color-navy);
  }
  .footer-contact { font-weight: 600; align-self: flex-start; }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-meta {
    padding-bottom: 32px;
    font-size: 14px;
    color: var(--color-ink-subtle);
  }
</style>
