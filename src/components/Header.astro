---
const navItems = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about/" },
  { label: "Projects", href: "/projects/" },
  { label: "Scholarship", href: "/scholarship/" },
  { label: "Recognition", href: "/recognition/" },
  { label: "Contact", href: "/contact/" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="border-b border-gray-200 bg-white">
  <div class="max-w-6xl mx-auto px-6 py-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <a href="/" class="font-display text-xl font-semibold text-navy">
      Jiaqi Yu, <span class="text-gold italic">PhD</span>
    </a>
    <nav aria-label="Primary">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 list-none p-0 m-0">
        {navItems.map(item => (
          <li>
            <a     
              href={item.href}
              class:list={[
                "nav-link text-sm font-medium tracking-wide uppercase",
                isActive(item.href) ? "active" : "",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  a { text-decoration: none; }
  .nav-link {
    color: var(--color-ink);
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s, color 0.2s;
  }
  .nav-link:hover {
    border-bottom-color: var(--color-gold);
    color: var(--color-navy);
  }
  .nav-link.active {
    color: var(--color-navy);
    border-bottom-color: var(--color-gold);
  }
</style>